{
    "name": "snow-globe",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "https:setup": "node scripts/setup-https.mjs",
        "https:certificate": "node scripts/serve-certificate.mjs",
        "build": "vite build",
        "package:site": "npm run build && mkdir -p artifacts && COPYFILE_DISABLE=1 tar -czf artifacts/globe-tsl-blocks.tar.gz -C dist .",
        "preview": "vite preview",
        "test": "node --test tests/*.test.js"
    },
    "dependencies": {
        "three": "0.185.1",
        "three-blocks": "0.12.0",
        "tweakpane": "4.0.5"
    },
    "devDependencies": {
        "vite": "8.1.3"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
